# --- Public / safe (may use VITE_ only for non-secrets) ---
VITE_APP_NAME=Island Quest
VITE_APP_TIMEZONE=Asia/Makassar
VITE_USE_FIXTURE_API=true
VITE_API_BASE=/api

# --- Server-only (Netlify Functions / netlify dev) — NO VITE_ ---
APP_TIMEZONE=Asia/Makassar
APP_NAME=Island Quest

# ElevenLabs (server-only — never VITE_)
# Copy real values into .env (gitignored). Example public voices that work on free tier:
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Callum / Daniel / Lily / Bill / Matilda (verified against ElevenLabs TTS)
ELEVENLABS_CAPTAIN_CORAL_VOICE_ID=N2lVS1w4EtoT3dr4eOWO
ELEVENLABS_PROFESSOR_PAWS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_NOVA_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_REX_VOICE_ID=pqHfZKP75CvOlQylNhV4
ELEVENLABS_MIKO_VOICE_ID=XrExE9yKIg1WjnnlVkGX
LOCAL_API_PORT=8791

# Persistence: memory | file | blobs (default file = durable .data/ store)
IQ_STORE=file
IQ_STORE_PATH=


# Parent gate (family friction — not high security)
# Prefer PARENT_PIN_HASH; if missing, server may derive from PARENT_PIN
PARENT_PIN=2468
PARENT_PIN_HASH=
SESSION_SECRET=change-me-local-only

# Optional
SENTRY_DSN=
TTS_RATE_LIMIT_PER_MINUTE=30
TTS_MAX_CHARS=500
